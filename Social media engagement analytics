{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyNAFJEIe9kupFnwhNoTEhQ0"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["# ==========================================\n","# Task 1 – Data Import & Setup\n","# ==========================================\n","import re\n","import matplotlib.pyplot as plt\n","import numpy as np\n","import pandas as pd\n","import plotly.express as px\n","import seaborn as sns\n","\n","# 1. Import CSV using Pandas\n","df = pd.read_csv(\"social_media_engagement_5000.csv\")\n","\n","# 2. Check initial data types and structure\n","print(\"--- Initial Info ---\")\n","print(df.info())\n","\n","# 3. Convert date columns to datetime (assuming 'date' or 'post_date' column)\n","date_cols = [c for c in df.columns if \"date\" in c.lower()]\n","for col in date_cols:\n","    df[col] = pd.to_datetime(df[col], errors=\"coerce\")\n","\n","# 4. Use NumPy arrays for basic array operations\n","likes_array = np.array(df[\"likes\"]) if \"likes\" in df.columns else np.array([])\n","if likes_array.size > 0:\n","    print(f\"NumPy Mean Likes: {np.nanmean(likes_array):.2f}\")\n","\n","\n","# ==========================================\n","# Task 2 – Data Cleaning\n","# ==========================================\n","# 1. Cleaning Missing Data\n","print(\"\\nMissing values before cleaning:\")\n","print(df.isnull().sum())\n","\n","# Handle missing numeric data with median\n","num_cols = df.select_dtypes(include=[np.number]).columns\n","for col in num_cols:\n","    df[col] = df[col].fillna(df[col].median())\n","\n","# Handle missing categorical data with mode or forward-fill\n","cat_cols = df.select_dtypes(include=[\"object\"]).columns\n","for col in cat_cols:\n","    df[col] = df[col].ffill().bfill()\n","\n","# 2. Duplicate Handling\n","df.drop_duplicates(inplace=True)\n","\n","# 3. Data Formatting & Category Standardization\n","if \"gender\" in df.columns:\n","    df[\"gender\"] = df[\"gender\"].str.strip().str.capitalize()\n","\n","# Correct unrealistic values (outliers/negative values) in numeric metrics\n","for col in [\"likes\", \"comments\", \"shares\", \"impressions\", \"watch_time\"]:\n","    if col in df.columns:\n","        df[col] = df[col].apply(lambda x: max(0, x))\n","\n","# 4. Feature Cleaning\n","# Extract hashtag count from content/text\n","if \"content\" in df.columns:\n","\n","    def extract_hashtags(text):\n","        if pd.isna(text):\n","            return 0\n","        return len(re.findall(r\"#\\w+\", str(text)))\n","\n","    df[\"hashtag_count\"] = df[\"content\"].apply(extract_hashtags)\n","elif \"hashtags\" in df.columns:\n","    df[\"hashtag_count\"] = df[\"hashtags\"].apply(\n","        lambda x: (\n","            len(str(x).split(\",\")) if pd.notna(x) and str(x) != \"\" else 0\n","        )\n","    )\n","\n","# Clean sentiment labels\n","if \"sentiment\" in df.columns:\n","    df[\"sentiment\"] = df[\"sentiment\"].str.strip().str.lower()\n","\n","\n","# ==========================================\n","# Task 3 – Data Exploration using Pandas\n","# ==========================================\n","print(\"\\nDataset Shape:\", df.shape)\n","print(\"\\nFirst 5 rows:\")\n","print(df.head())\n","\n","print(\"\\nSummary Statistics:\")\n","print(df.describe())\n","\n","# Categorical distributions\n","for col in [\"post_type\", \"country\", \"sentiment\"]:\n","    if col in df.columns:\n","        print(f\"\\nUnique values in {col}:\", df[col].nunique())\n","        print(df[col].value_counts())\n","\n","# Correlation Matrix for numeric fields\n","numeric_df = df.select_dtypes(include=[np.number])\n","print(\"\\nCorrelation Matrix:\")\n","print(numeric_df.corr())\n","\n","# Groupby metrics\n","if \"post_type\" in df.columns and \"likes\" in df.columns:\n","    print(\n","        \"\\nAvg Likes by Post Type:\\n\", df.groupby(\"post_type\")[\"likes\"].mean()\n","    )\n","\n","\n","# ==========================================\n","# Task 4 – Data Wrangling\n","# ==========================================\n","# Create engagement_score = likes + comments*2 + shares*3\n","metrics = [\"likes\", \"comments\", \"shares\"]\n","if all(m in df.columns for m in metrics):\n","    df[\"engagement_score\"] = (\n","        df[\"likes\"] + (df[\"comments\"] * 2) + (df[\"shares\"] * 3)\n","    )\n","\n","# Engagement rate calculation (if impressions available)\n","if \"impressions\" in df.columns and \"engagement_score\" in df.columns:\n","    df[\"engagement_rate\"] = (\n","        df[\"engagement_score\"] / df[\"impressions\"].replace(0, 1)\n","    ) * 100\n","\n","# Log-transform highly skewed metrics\n","if \"likes\" in df.columns:\n","    df[\"log_likes\"] = np.log1p(df[\"likes\"])\n","\n","# Groupby summaries\n","group_cols = [\n","    c for c in [\"post_type\", \"country\", \"sentiment\"] if c in df.columns\n","]\n","if group_cols:\n","    print(\n","        \"\\nGrouped Summary by Post Type & Sentiment:\\n\",\n","        df.groupby(group_cols)[\"engagement_score\"].agg(\n","            [\"mean\", \"median\", \"std\"]\n","        ),\n","    )\n","\n","\n","# ==========================================\n","# Task 5 – Statistical Analysis\n","# ==========================================\n","stat_target_cols = [\n","    c\n","    for c in [\n","        \"likes\",\n","        \"comments\",\n","        \"shares\",\n","        \"watch_time\",\n","        \"engagement_rate\",\n","        \"followers\",\n","    ]\n","    if c in df.columns\n","]\n","\n","stats_summary = pd.DataFrame()\n","for col in stat_target_cols:\n","    stats_summary[col] = {\n","        \"Mean\": df[col].mean(),\n","        \"Median\": df[col].median(),\n","        \"Mode\": df[col].mode()[0] if not df[col].mode().empty else np.nan,\n","        \"Std Dev\": df[col].std(),\n","        \"Variance\": df[col].var(),\n","        \"25th Percentile\": df[col].quantile(0.25),\n","        \"75th Percentile\": df[col].quantile(0.75),\n","        \"Skewness\": df[col].skew(),\n","        \"Kurtosis\": df[col].kurt(),\n","    }\n","\n","print(\"\\n--- Descriptive Statistics Table ---\")\n","print(stats_summary.T)\n","\n","\n","# ==========================================\n","# Task 6 – Data Visualization\n","# ==========================================\n","sns.set_theme(style=\"whitegrid\")\n","\n","# --- Matplotlib Plots ---\n","# 1. Scatter Plot: Likes vs Impressions\n","if \"likes\" in df.columns and \"impressions\" in df.columns:\n","    plt.figure(figsize=(6, 4))\n","    plt.scatter(\n","        df[\"impressions\"], df[\"likes\"], alpha=0.5, color=\"blue\", edgecolors=\"w\"\n","    )\n","    plt.title(\"Scatter Plot: Likes vs Impressions\")\n","    plt.xlabel(\"Impressions\")\n","    plt.ylabel(\"Likes\")\n","    plt.show()\n","\n","# 2. Line Plot: Daily Engagement Trend\n","date_col = date_cols[0] if date_cols else None\n","if date_col and \"engagement_score\" in df.columns:\n","    daily_trend = df.groupby(date_col)[\"engagement_score\"].sum().reset_index()\n","    plt.figure(figsize=(8, 4))\n","    plt.plot(\n","        daily_trend[date_col],\n","        daily_trend[\"engagement_score\"],\n","        color=\"teal\",\n","        marker=\"o\",\n","    )\n","    plt.title(\"Daily Engagement Trend\")\n","    plt.xlabel(\"Date\")\n","    plt.ylabel(\"Total Engagement Score\")\n","    plt.show()\n","\n","# 3. Bar Chart: Posts by Category / Post Type\n","if \"post_type\" in df.columns:\n","    plt.figure(figsize=(6, 4))\n","    df[\"post_type\"].value_counts().plot(kind=\"bar\", color=\"skyblue\")\n","    plt.title(\"Posts by Category / Post Type\")\n","    plt.xlabel(\"Post Type\")\n","    plt.ylabel(\"Count\")\n","    plt.show()\n","\n","# 4. Pie Chart: Gender Distribution\n","if \"gender\" in df.columns:\n","    plt.figure(figsize=(5, 5))\n","    df[\"gender\"].value_counts().plot(\n","        kind=\"pie\", autopct=\"%1.1f%%\", colors=[\"#ff9999\", \"#66b3ff\", \"#99ff99\"]\n","    )\n","    plt.title(\"Gender Distribution\")\n","    plt.ylabel(\"\")\n","    plt.show()\n","\n","# 5. Histogram: Age\n","if \"age\" in df.columns:\n","    plt.figure(figsize=(6, 4))\n","    plt.hist(df[\"age\"], bins=15, color=\"purple\", edgecolor=\"black\", alpha=0.7)\n","    plt.title(\"Histogram: Age Distribution\")\n","    plt.xlabel(\"Age\")\n","    plt.ylabel(\"Frequency\")\n","    plt.show()\n","\n","# 6. Box Plot: Engagement Rate\n","if \"engagement_rate\" in df.columns:\n","    plt.figure(figsize=(6, 4))\n","    plt.boxplot(df[\"engagement_rate\"].dropna(), vert=False)\n","    plt.title(\"Boxplot: Engagement Rate\")\n","    plt.xlabel(\"Engagement Rate (%)\")\n","    plt.show()\n","\n","# --- Seaborn Plots ---\n","# 7. Count Plot: Post Type\n","if \"post_type\" in df.columns:\n","    plt.figure(figsize=(6, 4))\n","    sns.countplot(data=df, x=\"post_type\", palette=\"Set2\")\n","    plt.title(\"Countplot: Post Type\")\n","    plt.show()\n","\n","# 8. Bar Plot: Avg Likes by Category\n","if \"post_type\" in df.columns and \"likes\" in df.columns:\n","    plt.figure(figsize=(6, 4))\n","    sns.barplot(\n","        data=df, x=\"post_type\", y=\"likes\", estimator=np.mean, palette=\"viridis\"\n","    )\n","    plt.title(\"Bar Plot: Avg Likes by Category\")\n","    plt.show()\n","\n","# 9. Heatmap: Correlation Matrix\n","plt.figure(figsize=(8, 6))\n","sns.heatmap(numeric_df.corr(), annot=True, cmap=\"coolwarm\", fmt=\".2f\")\n","plt.title(\"Heatmap: Correlation Matrix\")\n","plt.show()\n","\n","# 10. Swarm Plot / Violin Plot: Followers vs Sentiment\n","if \"sentiment\" in df.columns and \"followers\" in df.columns:\n","    plt.figure(figsize=(7, 4))\n","    sns.violinplot(\n","        data=df, x=\"sentiment\", y=\"followers\", palette=\"pastel\", inner=\"quartile\"\n","    )\n","    plt.title(\"Violin Plot: Followers vs Sentiment\")\n","    plt.show()\n","\n","# --- Plotly Interactive Plot ---\n","if \"impressions\" in df.columns and \"likes\" in df.columns:\n","    fig = px.scatter(\n","        df,\n","        x=\"impressions\",\n","        y=\"likes\",\n","        color=\"post_type\" if \"post_type\" in df.columns else None,\n","        size=\"engagement_score\" if \"engagement_score\" in df.columns else None,\n","        title=\"Interactive Scatter Plot: Impressions vs Likes\",\n","    )\n","    fig.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"UhCqaDpxvzFi","executionInfo":{"status":"ok","timestamp":1790091159795,"user_tz":-330,"elapsed":3040,"user":{"displayName":"anjitha lakshmi g s","userId":"12929020917499848414"}},"outputId":"a46ae4b7-0e0f-4297-ec76-1399f49995a9"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["--- Initial Info ---\n","<class 'pandas.core.frame.DataFrame'>\n","RangeIndex: 5000 entries, 0 to 4999\n","Data columns (total 19 columns):\n"," #   Column            Non-Null Count  Dtype  \n","---  ------            --------------  -----  \n"," 0   user_id           5000 non-null   int64  \n"," 1   age               4850 non-null   float64\n"," 2   gender            4850 non-null   object \n"," 3   country           5000 non-null   object \n"," 4   post_id           5000 non-null   int64  \n"," 5   post_type         5000 non-null   object \n"," 6   post_category     5000 non-null   object \n"," 7   likes             4850 non-null   float64\n"," 8   comments          4850 non-null   float64\n"," 9   shares            4850 non-null   float64\n"," 10  watch_time_sec    5000 non-null   int64  \n"," 11  impression_count  5000 non-null   int64  \n"," 12  posted_at         5000 non-null   object \n"," 13  follower_count    5000 non-null   int64  \n"," 14  is_verified       5000 non-null   bool   \n"," 15  device_type       5000 non-null   object \n"," 16  sentiment         4850 non-null   object \n"," 17  hashtags          5000 non-null   object \n"," 18  engagement_rate   5000 non-null   float64\n","dtypes: bool(1),